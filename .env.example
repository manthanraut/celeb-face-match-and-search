NODE_ENV=development
PORT=3000
RECOGNITION_PROVIDER=aws-rekognition
# Use RECOGNITION_PROVIDER=fake for deterministic local recognition without AWS credentials.
AWS_REGION=us-east-1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=celeb_face_match
UPLOAD_DIR=data/uploads
RECOGNITION_APPROVAL_THRESHOLD=99

# Prefer an AWS profile or temporary credentials in your shell. Never expose
# credentials through VITE_* variables because those are bundled for browsers.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
