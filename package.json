{
  "name": "celeb-face-match-and-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && tsc --project tsconfig.server.json",
    "start": "node dist-server/server/index.js",
